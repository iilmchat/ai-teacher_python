# Application
APP_NAME=AI Teacher for Python
# Версия приложения задаётся в backend/app/config.py (сверяется
# scripts/check_version.py с pyproject.toml и frontend/package.json).
# Переменная VERSION здесь не нужна: она перекрывала бы версию из кода.
DEBUG=true
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# S34-003: список IP/CIDR обратного прокси (Caddy/nginx), которым доверяем
# X-Forwarded-For. Пусто — используется только TCP-peer. Пример:
# TRUSTED_PROXIES=127.0.0.1,10.0.0.0/8
TRUSTED_PROXIES=
# S34-006: Swagger/ReDoc/OpenAPI. В production — false.
DOCS_ENABLED=true

# Database (PostgreSQL 17)
POSTGRES_HOST=127.0.0.1
# Внешний порт контейнера Postgres. Если 5434 занят — задайте свободный (см. KI-001)
POSTGRES_PORT=5434
POSTGRES_USER=ai_teacher
POSTGRES_PASSWORD=change_me_password
POSTGRES_DB=ai_teacher

# Redis
REDIS_HOST=127.0.0.1
# Внешний порт контейнера Redis. Если 6381 занят — задайте свободный (см. KI-001)
REDIS_PORT=6381
REDIS_DB=0

# Security
SECRET_KEY=change_me_secret_key_for_jwt_encoding
# S38-002: альтернатива — файл (Docker secret/K8s); приоритет выше ENV.
# SECRET_KEY_FILE=/run/secrets/secret_key
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
ALGORITHM=HS256

# LLM Provider (deepseek or lm_studio)
LLM_PROVIDER=deepseek
# Резервный провайдер при недоступности основного: deepseek | lm_studio | echo
# Пусто — fallback выключен (S12-002)
LLM_FALLBACK_PROVIDER=
DEEPSEEK_API_KEY=your_deepseek_api_key_here
# DEEPSEEK_API_KEY_FILE=/run/secrets/deepseek_api_key
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
LM_STUDIO_URL=http://localhost:1234/v1
# Модель, загруженная в LM Studio (см. GET /v1/models)
LM_STUDIO_MODEL=local-model
LLM_MAX_TOKENS=2000
LLM_TEMPERATURE=0.7
# S38-004: фильтр prompt injection/токсичности и защитные инструкции.
LLM_GUARDRAILS_ENABLED=true

# Code Execution
EXECUTOR_TIMEOUT=5
# native — дочерний интерпретатор (Job Object/RLIMIT_AS); container — отдельный
# контейнер (network none, read-only rootfs, cap-drop ALL), S24.
EXECUTOR_MODE=native
EXECUTOR_IMAGE=ai-teacher-sandbox-runner:latest
EXECUTOR_MEMORY_LIMIT=128
EXECUTOR_MAX_OUTPUT=100000
EXECUTOR_MAX_CONCURRENCY=4
EXECUTOR_QUEUE_TIMEOUT=5
# Пул тёплых интерпретаторов (S23-002): 0 — выключить, каждый батч поднимает
# свой процесс. Не больше EXECUTOR_MAX_CONCURRENCY.
EXECUTOR_POOL_SIZE=2
# Через сколько задач процесс пула перезапускается
EXECUTOR_POOL_MAX_TASKS=50
# S39-004: максимальный размер загружаемого файла (импорт задач), байты
MAX_UPLOAD_BYTES=10485760

# Наполнять БД стартовым набором задач при запуске (S14-002)
SEED_ON_START=true

# Метрики Prometheus (S25-002): /metrics без авторизации для внутренней сети
METRICS_ENABLED=true
METRICS_PATH=/metrics
# KI-024: несколько воркеров — общий экспортёр через multiprocess-каталог
# (uvicorn --workers N). Каталог чистит docker-entrypoint перед стартом.
# В prod-compose включается автоматически: UVICORN_WORKERS=2.
UVICORN_WORKERS=1
# PROMETHEUS_MULTIPROC_DIR=/tmp/prometheus-multiproc

# Sentry (S35-002): пусто — выключено. PII не отправляется (before_send).
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
# Доля performance-транзакций (0 — только ошибки)
SENTRY_TRACES_SAMPLE_RATE=0
# Релиз (версия + git-sha); пусто — версия приложения
SENTRY_RELEASE=

# Redis-кэш справочников (S19-003)
CACHE_ENABLED=true
CACHE_TTL_SECONDS=60

# Retention (S26-003): сколько дней хранить; 0 — не удалять (таблица).
# Встроенный планировщик (KI-025) по умолчанию выключен: в production он
# включён через docker-compose.prod.yml, в dev — запускайте скрипт вручную.
# Альтернатива планировщику — внешний cron (DESIGN_ADMIN_AND_OPS §11).
RETENTION_CHAT_MESSAGES_DAYS=90
RETENTION_CODE_EXECUTIONS_DAYS=90
RETENTION_NOTIFICATIONS_DAYS=180
RETENTION_AUDIT_LOG_DAYS=365
# История попыток по задачам (S42-002)
RETENTION_TASK_ATTEMPTS_DAYS=90
# Включить фоновый планировщик retention (раз в сутки)
RETENTION_SCHEDULER_ENABLED=false
# Время запуска в UTC, формат HH:MM
RETENTION_SCHEDULER_AT=03:30
# Размер батча удаления (как у CLI --batch-size)
RETENTION_SCHEDULER_BATCH_SIZE=1000
