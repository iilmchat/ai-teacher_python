# Application
APP_NAME=AI Teacher for Python
VERSION=0.1.0
DEBUG=true
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Database (PostgreSQL 17)
POSTGRES_HOST=127.0.0.1
# Внешний порт контейнера Postgres. Если 5434 занят — задайте свободный (см. KI-001)
POSTGRES_PORT=5434
POSTGRES_USER=ai_teacher
POSTGRES_PASSWORD=change_me_password
POSTGRES_DB=ai_teacher

# Redis
REDIS_HOST=127.0.0.1
# Внешний порт контейнера Redis. Если 6381 занят — задайте свободный (см. KI-001)
REDIS_PORT=6381
REDIS_DB=0

# Security
SECRET_KEY=change_me_secret_key_for_jwt_encoding
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
ALGORITHM=HS256

# LLM Provider (deepseek or lm_studio)
LLM_PROVIDER=deepseek
# Резервный провайдер при недоступности основного: deepseek | lm_studio | echo
# Пусто — fallback выключен (S12-002)
LLM_FALLBACK_PROVIDER=
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
LM_STUDIO_URL=http://localhost:1234/v1
LLM_MAX_TOKENS=2000
LLM_TEMPERATURE=0.7

# Code Execution
EXECUTOR_TIMEOUT=5
EXECUTOR_MEMORY_LIMIT=128
