# Production ENV для docker-compose.prod.yml (S36).
# Скопируйте в .env.prod (gitignored) и заполните. Секреты не коммитить.
#
#   cp .env.prod.example .env.prod
#   $EDITOR .env.prod
#   bash scripts/pin_images.sh --tag v0.6.0   # зафиксировать digest
#   bash scripts/deploy.sh

# --- Домен и TLS (Caddy) ---
# Публичное имя; Let's Encrypt должен уметь достучаться до 80/443.
DOMAIN=teacher.example.com
# Пилот на общем VPS: свой Caddy на нестандартных портах (проксирует внешний).
CADDY_HTTP_PORT=80
CADDY_HTTPS_PORT=443

# --- Образы GHCR ---
# GHCR_OWNER — владелец пакетов на GitHub (нижний регистр).
GHCR_OWNER=iilmchat
IMAGE_TAG=v0.6.0
# Полные ссылки с digest заполняет scripts/pin_images.sh.
# BACKEND_IMAGE=ghcr.io/iilmchat/ai-teacher-backend@sha256:...
# FRONTEND_IMAGE=ghcr.io/iilmchat/ai-teacher-frontend@sha256:...
# SANDBOX_IMAGE=ghcr.io/iilmchat/ai-teacher-sandbox-runner@sha256:...

# --- Секреты приложения ---
SECRET_KEY=change_me_random_32_chars_minimum
POSTGRES_USER=ai_teacher
POSTGRES_PASSWORD=change_me_password
POSTGRES_DB=ai_teacher

# --- Сеть ---
# Docker-подсеть edge-сети: должна совпадать с TRUSTED_PROXIES (Caddy).
DOCKER_SUBNET=10.77.0.0/16
TRUSTED_PROXIES=10.77.0.0/16

# --- LLM ---
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# --- Observability (S35) ---
UVICORN_WORKERS=2
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0
# SENTRY_RELEASE обычно выставляется из IMAGE_TAG в compose.
METRICS_ENABLED=true

# --- Бэкапы (S36-006) ---
BACKUP_DIR=/var/backups/ai-teacher
BACKUP_RETENTION_DAYS=14
# age-шифрование (рекомендуется): публичный ключ получателя.
AGE_RECIPIENT=
# Приватный ключ нужен только для restore; храните вне репозитория.
# AGE_IDENTITY=/etc/ai-teacher/age.key
# Selectel S3 (если заданы — backup.sh выгрузит архив).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ru-1
S3_BUCKET=
S3_PREFIX=ai-infra-backups/ai-teacher/
S3_ENDPOINT_URL=https://s3.storage.selcloud.ru
# node-exporter textfile: backup_last_success_timestamp для алерта BackupStale.
TEXTFILE_DIR=/var/lib/node_exporter/textfile

# --- Grafana (профиль monitoring, S35) ---
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change_me_grafana
