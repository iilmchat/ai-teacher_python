# Правила EOL для скриптов и конфигов CI.
# Bash-скрипты обязаны иметь LF, иначе падают в Linux-контейнерах/агентах
# при checkout на Windows (core.autocrlf=true).
*.sh text eol=lf
*.bash text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.ps1 text eol=crlf
*.psm1 text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf
*.xml text eol=lf
