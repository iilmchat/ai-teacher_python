# /etc/ai-teacher/backup.env — окружение systemd-таймера (S36-006).
# Права: root:root, 0600 (содержит S3-ключи и age-recipient).
#
# Установка:
#   sudo install -d -m 0750 /etc/ai-teacher
#   sudo install -m 0600 deploy/systemd/backup.env.example /etc/ai-teacher/backup.env
#   sudo editor /etc/ai-teacher/backup.env
#   sudo cp deploy/systemd/ai-teacher-backup.* /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now ai-teacher-backup.timer

COMPOSE_FILE=/opt/ai-teacher/docker-compose.prod.yml
ENV_FILE=/opt/ai-teacher/.env.prod
BACKUP_DIR=/var/backups/ai-teacher
BACKUP_RETENTION_DAYS=14

# age-шифрование (публичный ключ получателя; приватный — только у владельца)
AGE_RECIPIENT=

# Selectel S3 (если пусто — бэкап только локально)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ru-1
S3_BUCKET=
S3_PREFIX=ai-infra-backups/ai-teacher/
S3_ENDPOINT_URL=https://s3.storage.selcloud.ru

# node-exporter textfile → метрика backup_last_success_timestamp
TEXTFILE_DIR=/var/lib/node_exporter/textfile
